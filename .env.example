# ── 內網 build（只有 docker compose build 會用到）─────────────
# 需要走 proxy / 內部 PyPI 鏡像時才填；公司自簽 CA 請放到 certs/ 目錄。
# HTTPS_PROXY=http://proxy.corp:3128
# HTTP_PROXY=http://proxy.corp:3128
# NO_PROXY=localhost,127.0.0.1,.corp
# PIP_INDEX_URL=https://nexus.corp/repository/pypi-proxy/simple
# PIP_TRUSTED_HOST=nexus.corp

# ── PostgreSQL（只有疊 docker-compose.postgres.yml 時會用到）──
# POSTGRES_PASSWORD=
# POSTGRES_USER=sarfi
# POSTGRES_DB=sa_rfi

# ── 本 App ────────────────────────────────────────────────────
# 本平台對外的 Base URL（OAuth callback 與絕對連結皆以此為基礎）
# 若部署在反向代理子路徑下，請填完整含路徑，例：http://rad-ai/sa-rfi-management
APP_BASE_URL=http://localhost:8003

# 反向代理子路徑前綴；留空會自動取 APP_BASE_URL 的路徑（如 /sa-rfi-management）。
# 根目錄部署則為空。
# ROOT_PATH=/sa-rfi-management

# ── Auth Center SSO（OAuth2 / OIDC）────────────────────────────
# Auth Center 服務位址
AUTH_CENTER_BASE_URL=http://localhost:8000

# 在 Auth Center apps.yaml 中註冊的 App ID
APP_ID=sa_rfi_management

# App 明文密鑰（對應 apps.yaml 中的 bcrypt hash）
CLIENT_SECRET=sa_rfi_secret_change_me

# OAuth2 callback URL（需與 apps.yaml 中的 redirect_uri 一致）
# 留空則自動使用 {APP_BASE_URL}/auth/callback
REDIRECT_URI=

# JWT 驗章方式（擇一即可）：
#   1) 建議：使用 Auth Center 的 JWKS 端點自動取得公鑰（免維護 public.pem）。
#      留空 JWKS_URL 時會自動用 {AUTH_CENTER_BASE_URL}/.well-known/jwks.json。
#      要自訂可填完整網址；要停用 JWKS 則把 JWKS_URL 設為空字串。
# JWKS_URL=http://your-auth-center/.well-known/jwks.json
#   2) 離線後備：本地 RS256 公鑰（需與 Auth Center 簽章私鑰成對）。
PUBLIC_KEY_PATH=./keys/public.pem

# ── 狀態存放位置 ──────────────────────────────────────────────
# 這個 App 是 stateless 的：所有重啟後必須還在的東西（SQLite 檔、附件）
# 都寫在 DATA_DIR 底下。容器部署時把 DATA_DIR 掛成 volume 就好，
# 不需要再逐項設定下面那些路徑。
DATA_DIR=.

# ── 資料庫（SQLite 與 PostgreSQL 皆支援）─────────────────────
# 留空 = 用 SQLite，檔案放在 {DATA_DIR}/sa_rfi.db。
# 適合單一副本；要跑多副本請改用 PostgreSQL（SQLite 不支援多寫入者）。
#
# 要用 PostgreSQL 就填這一行，可直接貼常見的同步版字串，
# App 會自動換成 async driver（asyncpg）：
# DATABASE_URL=postgresql://sarfi:password@postgres:5432/sa_rfi
DATABASE_URL=

# 進階：只想換 SQLite 檔案位置、不改 DATA_DIR 時才需要
# SQLITE_PATH=./sa_rfi.db

# 進階：只想把附件放到別的地方時才需要（預設 {DATA_DIR}/uploads）
# 每筆 RFI 的檔案會存到子資料夾「RFI編號_終端客戶」內
# UPLOAD_DIR=./uploads

# 單一附件大小上限（MB）
MAX_UPLOAD_MB=25

# Cookie 是否限定 HTTPS（正式環境設 true）
COOKIE_SECURE=false

# 投影片標題（匯出 PPT 的封面標題，會自動接上週別區間）
DECK_TITLE=Customer RFI Collection

# 頁尾署名（留空則不顯示）
DESIGNED_BY=
EXECUTED_BY=

# 靜態資源版本（快取破壞用）。跑多副本時請設成 image tag / commit sha，
# 讓每個副本回傳同一個值；留空則以各自的啟動時間為準。
ASSET_VERSION=

# 注意：服務埠號由啟動指令的 --port 指定（見 README），不在此設定。

# ── 日誌（loguru）─────────────────────────────────────────────
# 等級：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 留空 = 只輸出到 stdout/stderr，交給容器平台收集（容器部署請保持留空）。
# 傳統主機部署想自己留輪替檔（10MB、保留 14 天）時才填路徑：
# LOG_FILE=./logs/sa_rfi.log
LOG_FILE=

# ── 開發模式 ──────────────────────────────────────────────────
# 設為 true 時略過 Auth Center 認證，注入測試使用者（僅限本機開發！）
DEV_AUTH_BYPASS=false
DEV_USER=dev.user
DEV_SCOPES=read,write,admin
