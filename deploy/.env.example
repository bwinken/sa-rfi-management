# ═══════════════════════════════════════════════════════════════
#  SA RFI 管理平台 — 正式環境 .env 範本（docker compose 用）
#
#  用法：cp deploy/.env.example .env  然後填值
#  或者：bash deploy/1_env_setup.sh   逐項問你、自動產生 .env
#
#  這個檔案只會被 docker compose 讀來代換 docker-compose.yml（由 2_compose_setup.sh 產生）的 ${VAR}，
#  不會進 image（.dockerignore 已排除）。改完 docker compose up -d 即生效。
#  根目錄的 .env.example 是開發用（DATA_DIR=. 等），這份是給正式部署的。
# ═══════════════════════════════════════════════════════════════

# ── 1. 必填 ────────────────────────────────────────────────────

# 本平台對外網址。OAuth callback 會組成 {APP_BASE_URL}/auth/callback，
# 必須與 Auth Center 註冊的 redirect_uri 逐字一致（含 https、無尾端 /）。
# 部署在子路徑時填完整含路徑，例：https://portal.corp/sa-rfi
APP_BASE_URL=https://rfi.corp.example

# Auth Center 網址（尾端不要加 /）
AUTH_CENTER_BASE_URL=https://auth.corp.example

# 在 Auth Center 註冊的 app_id
APP_ID=sa_rfi_management

# Auth Center 產生的「明文」client_secret（apps.yaml 裡存的是它的 bcrypt hash）
CLIENT_SECRET=

# 走 HTTPS 一律 true；只有純 http 測試才 false
COOKIE_SECURE=true

# 靜態資源版本，填 image tag 或 commit sha；每次升級都要換，否則使用者拿到舊 CSS
ASSET_VERSION=

# ── 2. 認證進階（通常不用動）──────────────────────────────────

# 留空 = 自動 {APP_BASE_URL}/auth/callback
REDIRECT_URI=

# 驗章公鑰端點。留空 = 自動 {AUTH_CENTER_BASE_URL}/.well-known/jwks.json；
# 容器連不到 Auth Center 時填 off，並把 public.pem 放進 volume 的 keys/（見 deploy/README.md 第 5 節）
JWKS_URL=

# 離線後備公鑰位置（容器內路徑）
PUBLIC_KEY_PATH=/data/keys/public.pem

# ── 3. 應用設定（有預設）──────────────────────────────────────

# 反向代理子路徑前綴；留空自動由 APP_BASE_URL 推導
ROOT_PATH=

# 留空 = SQLite 在 volume 的 /data/sa_rfi.db。
# 要用 PostgreSQL 請在 2_compose_setup.sh 第 4 步選 PostgreSQL 並設定下方第 5 節，不要直接填這裡。
DATABASE_URL=

MAX_UPLOAD_MB=25
DECK_TITLE=Customer RFI Collection
DESIGNED_BY=
EXECUTED_BY=
LOG_LEVEL=INFO

# ── 4. 開發模式 —— 正式環境保持 false ────────────────────────
DEV_AUTH_BYPASS=false
DEV_USER=dev.user
DEV_SCOPES=read,write,admin

# ── 5. PostgreSQL（只有 2_compose_setup.sh 選 PostgreSQL 才用到）─
# POSTGRES_PASSWORD=
# POSTGRES_USER=sarfi
# POSTGRES_DB=sa_rfi

# ── 6. 內網 build（只有 docker compose build 用到；2_compose_setup.sh 第 5 步選 yes 才會進容器）
# HTTPS_PROXY=http://proxy.corp:3128
# HTTP_PROXY=http://proxy.corp:3128
# NO_PROXY=localhost,127.0.0.1,.corp
# PIP_INDEX_URL=https://nexus.corp/repository/pypi-proxy/simple
# PIP_TRUSTED_HOST=nexus.corp
